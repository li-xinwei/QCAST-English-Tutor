      "phrases": ["It lives in...", "What does it eat?", "Can it...?", "How does it survive?", "Why does it...?", "Its habitat is..."],
      "grammar": ["Can/Cannot", "Present simple for facts", "Adjectives", "Because/So"],
      "exercises": [
        "Match animals with habitats",
        "Describe an animal",
        "Write animal facts",
        "Create a food chain diagram",
        "Research endangered species"
      ]
    },
    {
