    {
      "unit": 2,
      "title": "Environment and Conservation",
      "vocabulary": ["pollution", "recycling", "ecosystem", "climate", "endangered", "sustainable", "renewable", "biodiversity", "conservation", "habitat", "resources", "impact"],
      "phrases": ["We should...", "If we don't...", "It's important to...", "The consequences are...", "This affects...", "We can solve this by..."],
      "grammar": ["Modal verbs", "Second conditional", "Cause and effect", "Passive voice", "Future perfect"],
      "exercises": [
        "Write a persuasive essay",
        "Create an action plan",
        "Research environmental issues",
        "Design a conservation project",
        "Present solutions"
      ]
    },
    {
      "unit": 3,
      "title": "Historical Events",
