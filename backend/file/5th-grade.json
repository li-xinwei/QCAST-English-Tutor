      "title": "Space and Astronomy",
      "vocabulary": ["planet", "galaxy", "universe", "orbit", "constellation", "telescope", "astronaut", "satellite", "comet", "gravity", "atmosphere", "exploration"],
      "phrases": ["Scientists believe...", "Research indicates...", "The evidence suggests...", "This phenomenon occurs...", "In the future...", "Current theories state..."],
      "grammar": ["Scientific present", "Future predictions", "Hypothetical situations", "Comparative structures", "Technical vocabulary"],
      "exercises": [
        "Write a space research report",
