      "phrases": ["During this period...", "This led to...", "As a result...", "Historical records show...", "This changed...", "The significance was..."],
      "grammar": ["Past perfect", "Sequence words", "Passive voice in history", "Time expressions", "Reported speech"],
      "exercises": [
        "Create a timeline",
        "Write a historical account",
        "Analyze primary sources",
        "Compare different eras",
        "Research historical figures"
      ]
    },
    {
