      "unit": 1,
      "title": "Literature and Poetry",
      "vocabulary": ["metaphor", "simile", "rhythm", "verse", "stanza", "theme", "alliteration", "personification", "imagery", "rhyme scheme", "mood", "tone"],
      "phrases": ["The author suggests...", "This symbolizes...", "The main idea is...", "The poet uses...", "This creates an effect of...", "The mood is..."],
      "grammar": ["Perfect tenses", "Literary devices", "Reported speech", "Figurative language", "Complex sentences"],
